# Wajib. Minimal 32 karakter. Buat dengan:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port bawaan frontend adalah 8000
PORT=8000

# Lokal: berkas SQLite. Produksi: libsql://<nama-db>.turso.io
DATABASE_URL=file:./data/filmlog.db
# Hanya untuk Turso
DATABASE_AUTH_TOKEN=

# Ambil gratis di https://aistudio.google.com
# Boleh lebih dari satu, dipisah koma: key1,key2,key3
# Kalau satu key kena limit (429) atau ditolak (401/403), request pindah ke key berikutnya
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# "*" aman karena auth memakai Bearer token, tanpa cookie.
# Untuk membatasi, isi daftar dipisah koma: https://a.com,https://b.com
CORS_ORIGIN=*

# Isi 1 kalau berjalan di belakang satu reverse proxy (Render, Railway)
TRUST_PROXY=0
